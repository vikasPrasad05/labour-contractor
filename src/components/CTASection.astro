---
---

<section class="py-16 sm:py-20 bg-white border-b border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-zinc-50 border border-zinc-300 rounded-xs p-8 sm:p-12 relative overflow-hidden">
      
      <!-- Right Side Worker with Phone Illustration SVG -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-100 border border-amber-300 text-amber-900 text-xs font-bold uppercase tracking-wider rounded-xs">
            DIRECT CONTRACTOR DISPATCH
          </div>
          
          <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight leading-tight">
            Need Labour for Your Next Project?
          </h2>
          
          <p class="text-base text-zinc-600 font-normal leading-relaxed max-w-2xl">
            Tell us what kind of workforce you need, crew size, location, and start date. We'll discuss your site requirements and provide a transparent manpower quote within hours.
          </p>

          <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a 
              href="/contact" 
              class="inline-flex items-center justify-center px-6 py-3.5 bg-zinc-900 text-white text-xs sm:text-sm font-bold uppercase tracking-wider rounded-xs hover:bg-amber-600 transition-colors shadow-xs"
            >
              Request Manpower Now
            </a>

            <a 
              href="tel:+919723740019" 
              class="inline-flex items-center justify-center px-6 py-3.5 bg-white text-zinc-900 border border-zinc-300 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-xs hover:bg-zinc-100 transition-colors"
            >
              <svg class="w-4 h-4 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Call +91 9723740019
            </a>
          </div>
        </div>

        <!-- Worker with Phone SVG Graphic -->
        <div class="lg:col-span-4 flex justify-center">
          <div class="w-48 h-48 sm:w-56 sm:h-56 bg-white border-2 border-zinc-900 p-4 rounded-xs flex items-center justify-center shadow-[4px_4px_0px_0px_rgba(24,24,27,1)]">
            <svg class="w-full h-full" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="100" cy="100" r="90" fill="#FAFAFA" stroke="#E4E4E7" stroke-width="2" />
              
              <!-- Dispatcher Worker Body -->
              <path d="M60 190 V140 C60 125 72 115 100 115 C128 115 140 125 140 140 V190" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
              <rect x="75" y="125" width="50" height="45" fill="#FDE047" stroke="#18181B" stroke-width="1.5" />
              <line x1="75" y1="140" x2="125" y2="140" stroke="#FFFFFF" stroke-width="3" />

              <!-- Head & Helmet -->
              <circle cx="100" cy="85" r="18" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
              <path d="M76 80 C76 60 86 52 100 52 C114 52 124 60 124 80 Z" fill="#D97706" stroke="#18181B" stroke-width="2" />
              <path d="M70 80 H130" stroke="#18181B" stroke-width="3" stroke-linecap="round" />

              <!-- Phone Hand Graphic -->
              <rect x="125" y="70" width="16" height="28" rx="2" fill="#18181B" stroke="#18181B" stroke-width="1.5" />
              <rect x="128" y="74" width="10" height="16" fill="#60A5FA" />
              <!-- Call Waves -->
              <path d="M148 72 C152 78 152 86 148 92" stroke="#D97706" stroke-width="2" stroke-linecap="round" />
            </svg>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
