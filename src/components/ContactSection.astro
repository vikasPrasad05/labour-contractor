---
---

<section id="contact" class="py-16 sm:py-20 lg:py-24 bg-white border-b border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Seamless Two-Column Printed Layout (No Boxed Card Wrapper) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- LEFT COLUMN: Printed Contact Info & Trust Details -->
      <div class="lg:col-span-5 space-y-8">
        
        <!-- Main Headline -->
        <div class="space-y-3">
          <h2 class="text-3xl sm:text-4xl lg:text-4xl font-extrabold tracking-tight text-zinc-900 leading-tight">
            Have A Requirement In Mind?<br />
            <span class="text-amber-700">Let's Get Started.</span>
          </h2>
          <p class="text-base text-zinc-600 leading-relaxed font-normal">
            Tell us about your project scope, workforce trades, and site timeline. We'll provide transparent crew quotes and fast deployment.
          </p>
        </div>

        <!-- Feature Bullet List -->
        <ul class="space-y-3.5 text-sm text-zinc-700 font-normal border-y border-zinc-200 py-6">
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center font-extrabold text-xs shrink-0">✓</span>
            <span class="font-medium">Expect A Quick Response Within 2 Hours</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center font-extrabold text-xs shrink-0">✓</span>
            <span class="font-medium">100% Vetted Labour, Wage & Safety Compliance</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center font-extrabold text-xs shrink-0">✓</span>
            <span class="font-medium">Direct On-Site Supervision & Flexible Crew Scaling</span>
          </li>
        </ul>

        <!-- Direct Contact Info Cards (Manish Singh / Prapti Enterprise) -->
        <div class="space-y-4 pt-2">
          
          <!-- Contact Person & Numbers -->
          <div class="p-4 bg-zinc-50 border border-zinc-200 rounded-lg flex items-start gap-4">
            <div class="w-10 h-10 shrink-0 bg-amber-500 text-zinc-950 flex items-center justify-center rounded-lg font-bold text-lg">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-zinc-500 uppercase tracking-wider">Direct Contact Person</p>
              <p class="text-base font-extrabold text-zinc-900 mt-0.5">Manish Singh</p>
              <p class="text-sm font-bold text-amber-800 mt-1 flex items-center gap-2">
                <a href="tel:+919723740019" class="hover:underline">+91 9723740019</a> / 
                <a href="tel:+919723740009" class="hover:underline">9723740009</a>
              </p>
            </div>
          </div>

          <!-- Email -->
          <div class="p-4 bg-zinc-50 border border-zinc-200 rounded-lg flex items-start gap-4">
            <div class="w-10 h-10 shrink-0 bg-zinc-900 text-white flex items-center justify-center rounded-lg">
              <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-zinc-500 uppercase tracking-wider">Email Inquiry</p>
              <a href="mailto:manishsingh9723@gmail.com" class="text-sm font-bold text-zinc-900 hover:text-amber-700 transition-colors block mt-0.5 underline">
                manishsingh9723@gmail.com
              </a>
            </div>
          </div>

          <!-- Office Address -->
          <div class="p-4 bg-zinc-50 border border-zinc-200 rounded-lg flex items-start gap-4">
            <div class="w-10 h-10 shrink-0 bg-zinc-900 text-white flex items-center justify-center rounded-lg">
              <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-zinc-500 uppercase tracking-wider">Dispatch Office Address</p>
              <p class="text-xs text-zinc-700 leading-relaxed font-semibold mt-0.5">
                Shop No. 02, Pali Corner, Opp. Gram Panchayat,<br />
                Dadra, Dadra & Nagar Haveli & Daman & Diu - 396193
              </p>
            </div>
          </div>

        </div>

      </div>

      <!-- RIGHT COLUMN: Printed Form Directly on Page -->
      <div class="lg:col-span-7 pt-2 lg:pt-0">
        
        <form id="enquiry-form" class="space-y-6">
          
          <!-- Section Title -->
          <div class="pb-3 border-b border-zinc-200">
            <h3 class="text-xl sm:text-2xl font-extrabold text-zinc-900 tracking-tight">Requirement Request Form</h3>
          </div>

          <!-- Row 1: Name & Phone/Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="contact-name" class="block text-xs font-bold text-zinc-800 uppercase tracking-wider mb-2">
                Name <span class="text-amber-700">*</span>
              </label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                required 
                placeholder="Enter Your Name"
                class="w-full px-4 py-3 bg-zinc-50 border border-zinc-300 text-zinc-900 text-sm rounded-lg focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
              />
            </div>
            <div>
              <label for="contact-phone" class="block text-xs font-bold text-zinc-800 uppercase tracking-wider mb-2">
                Email / Phone <span class="text-amber-700">*</span>
              </label>
              <input 
                type="text" 
                id="contact-phone" 
                name="phone_email" 
                required 
                placeholder="Enter Your Phone or Email"
                class="w-full px-4 py-3 bg-zinc-50 border border-zinc-300 text-zinc-900 text-sm rounded-lg focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
              />
            </div>
          </div>

          <!-- Select Chips: What Do You Need? (3 per line) -->
          <div>
            <label class="block text-xs font-bold text-zinc-800 uppercase tracking-wider mb-2.5">
              What Do You Need?
            </label>
            <input type="hidden" id="selected-service-input" name="service" value="Construction Labour" />
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5" id="service-chips-container">
              <button 
                type="button" 
                data-value="Construction Labour"
                class="chip-btn active w-full py-2.5 px-3 text-xs font-bold rounded-lg border transition-all text-center bg-zinc-900 text-white border-zinc-900 shadow-xs"
              >
                Construction Labour
              </button>
              <button 
                type="button" 
                data-value="Industrial Manpower"
                class="chip-btn w-full py-2.5 px-3 text-xs font-bold rounded-lg border transition-all text-center bg-zinc-50 text-zinc-700 border-zinc-300 hover:bg-zinc-100 hover:text-zinc-900"
              >
                Industrial Manpower
              </button>
              <button 
                type="button" 
                data-value="Warehouse Crew"
                class="chip-btn w-full py-2.5 px-3 text-xs font-bold rounded-lg border transition-all text-center bg-zinc-50 text-zinc-700 border-zinc-300 hover:bg-zinc-100 hover:text-zinc-900"
              >
                Warehouse Crew
              </button>
              <button 
                type="button" 
                data-value="Loading & Unloading"
                class="chip-btn w-full py-2.5 px-3 text-xs font-bold rounded-lg border transition-all text-center bg-zinc-50 text-zinc-700 border-zinc-300 hover:bg-zinc-100 hover:text-zinc-900"
              >
                Loading & Unloading
              </button>
              <button 
                type="button" 
                data-value="Skilled Tradesmen"
                class="chip-btn w-full py-2.5 px-3 text-xs font-bold rounded-lg border transition-all text-center bg-zinc-50 text-zinc-700 border-zinc-300 hover:bg-zinc-100 hover:text-zinc-900"
              >
                Skilled Tradesmen
              </button>
              <button 
                type="button" 
                data-value="General Helpers"
                class="chip-btn w-full py-2.5 px-3 text-xs font-bold rounded-lg border transition-all text-center bg-zinc-50 text-zinc-700 border-zinc-300 hover:bg-zinc-100 hover:text-zinc-900"
              >
                General Helpers
              </button>
            </div>
          </div>

          <!-- Select Chips: Required Crew Size -->
          <div>
            <label class="block text-xs font-bold text-zinc-800 uppercase tracking-wider mb-2.5">
              Required Crew Size
            </label>
            <input type="hidden" id="selected-crew-input" name="crew_size" value="5–15 Workers" />
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="crew-chips-container">
              <button 
                type="button" 
                data-value="1–5 Workers"
                class="crew-btn w-full py-2.5 px-3 text-xs font-bold rounded-lg border transition-all text-center bg-zinc-50 text-zinc-700 border-zinc-300 hover:bg-zinc-100 hover:text-zinc-900"
              >
                1–5 Workers
              </button>
              <button 
                type="button" 
                data-value="5–15 Workers"
                class="crew-btn active w-full py-2.5 px-3 text-xs font-bold rounded-lg border transition-all text-center bg-zinc-900 text-white border-zinc-900 shadow-xs"
              >
                5–15 Workers
              </button>
              <button 
                type="button" 
                data-value="15–30 Workers"
                class="crew-btn w-full py-2.5 px-3 text-xs font-bold rounded-lg border transition-all text-center bg-zinc-50 text-zinc-700 border-zinc-300 hover:bg-zinc-100 hover:text-zinc-900"
              >
                15–30 Workers
              </button>
              <button 
                type="button" 
                data-value="30+ Workers"
                class="crew-btn w-full py-2.5 px-3 text-xs font-bold rounded-lg border transition-all text-center bg-zinc-50 text-zinc-700 border-zinc-300 hover:bg-zinc-100 hover:text-zinc-900"
              >
                30+ Workers
              </button>
            </div>
          </div>

          <!-- Project Brief Textarea -->
          <div>
            <label for="contact-brief" class="block text-xs font-bold text-zinc-800 uppercase tracking-wider mb-2">
              Project Brief / Site Location
            </label>
            <textarea 
              id="contact-brief" 
              name="project_brief" 
              rows="4" 
              placeholder="Write Here... (e.g. site address, shift timings, estimated duration, or specific worker requirements)"
              class="w-full px-4 py-3 bg-zinc-50 border border-zinc-300 text-zinc-900 text-sm rounded-lg focus:bg-white focus:border-zinc-900 focus:outline-none transition-all"
            ></textarea>
          </div>

          <!-- Submit Button & Feedback -->
          <div class="pt-2">
            <button 
              type="submit" 
              class="px-8 py-3.5 bg-zinc-900 hover:bg-amber-600 text-white font-bold text-sm rounded-lg transition-all shadow-md flex items-center justify-center gap-2 group cursor-pointer"
            >
              <span>Send Message</span>
              <svg class="w-4 h-4 text-amber-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </div>

          <div id="form-success" class="hidden p-4 bg-emerald-50 border border-emerald-300 text-emerald-900 text-xs font-semibold rounded-lg">
            ✓ Thank you! Your requirement has been sent to Manish Singh. Our dispatch desk will contact you shortly.
          </div>

        </form>

      </div>

    </div>

    <!-- Google Maps Location Section -->
    <div class="mt-16 pt-12 border-t border-zinc-200">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h3 class="text-2xl font-extrabold text-zinc-900 tracking-tight">Visit Our Dispatch Office</h3>
          <p class="text-xs sm:text-sm text-zinc-600 mt-1">Shop No. 02, Pali Corner, Opp. Gram Panchayat, Dadra, Dadra & Nagar Haveli & Daman & Diu - 396193</p>
        </div>
        <a 
          href="https://www.google.com/maps/search/?api=1&query=Shop+No.+02,+Pali+Corner,+Opp.+Gram+Panchayat,+Dadra,+Dadra+%26+Nagar+Haveli+-+396193" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-zinc-900 hover:bg-amber-600 text-white font-bold text-xs uppercase tracking-wider rounded-lg transition-colors shadow-xs shrink-0"
        >
          <span>Open In Google Maps</span>
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
      
      <div class="w-full h-80 sm:h-96 relative bg-zinc-100 rounded-xl overflow-hidden border border-zinc-300">
        <iframe 
          src="https://maps.google.com/maps?q=Shop+No.+02,+Pali+Corner,+Opp.+Gram+Panchayat,+Dadra,+Dadra+%26+Nagar+Haveli+-+396193&t=&z=15&ie=UTF8&iwloc=&output=embed" 
          class="w-full h-full border-0" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          title="Office Location Map - Vanguard Labour / Prapti Enterprise"
        ></iframe>
      </div>
    </div>

  </div>
</section>

<script>
  // Handle Service Chips selection
  const serviceBtns = document.querySelectorAll('.chip-btn');
  const serviceInput = document.getElementById('selected-service-input') as HTMLInputElement | null;

  serviceBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      serviceBtns.forEach(b => {
        b.classList.remove('bg-zinc-900', 'text-white', 'border-zinc-900', 'shadow-xs');
        b.classList.add('bg-zinc-50', 'text-zinc-700', 'border-zinc-300');
      });
      btn.classList.remove('bg-zinc-50', 'text-zinc-700', 'border-zinc-300');
      btn.classList.add('bg-zinc-900', 'text-white', 'border-zinc-900', 'shadow-xs');
      if (serviceInput) {
        serviceInput.value = btn.getAttribute('data-value') || '';
      }
    });
  });

  // Handle Crew Size Chips selection
  const crewBtns = document.querySelectorAll('.crew-btn');
  const crewInput = document.getElementById('selected-crew-input') as HTMLInputElement | null;

  crewBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      crewBtns.forEach(b => {
        b.classList.remove('bg-zinc-900', 'text-white', 'border-zinc-900', 'shadow-xs');
        b.classList.add('bg-zinc-50', 'text-zinc-700', 'border-zinc-300');
      });
      btn.classList.remove('bg-zinc-50', 'text-zinc-700', 'border-zinc-300');
      btn.classList.add('bg-zinc-900', 'text-white', 'border-zinc-900', 'shadow-xs');
      if (crewInput) {
        crewInput.value = btn.getAttribute('data-value') || '';
      }
    });
  });

  // Form submission handling
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');

  if (form && successMsg) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      successMsg.classList.remove('hidden');
      form.reset();
      setTimeout(() => {
        successMsg.classList.add('hidden');
      }, 7000);
    });
  }
</script>
