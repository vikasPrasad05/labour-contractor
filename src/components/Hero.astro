---
---

<section id="home" class="relative pt-12 pb-16 lg:pt-20 lg:pb-24 overflow-hidden border-b border-zinc-200">
  <!-- Subtle Blueprint Grid Accent background -->
  <div class="absolute inset-0 blueprint-grid opacity-40 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight leading-tight">
          Reliable Workforce.<br />
          Ready When You Need It.
        </h1>

        <!-- Supporting Paragraph -->
        <p class="text-base sm:text-lg text-zinc-600 max-w-2xl font-normal leading-relaxed">
          We provide dependable, verified labour and manpower solutions for construction site operations, industrial plants, commercial builds, and infrastructure developments. Flexible teams scaled to your timeline.
        </p>

        <!-- CTA Buttons & Quick Note (Hidden on mobile, visible on sm and up) -->
        <div class="pt-2 hidden sm:flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a 
            href="/contact" 
            class="inline-flex items-center justify-center px-6 py-3.5 bg-zinc-900 text-white text-xs sm:text-sm font-bold uppercase tracking-wider rounded-xs hover:bg-amber-600 transition-colors shadow-xs group"
          >
            <span>Request Manpower</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href="tel:+919723740019" 
            class="inline-flex items-center justify-center px-6 py-3.5 bg-white text-zinc-900 border-2 border-zinc-900 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-xs hover:bg-zinc-50 transition-colors"
          >
            <svg class="w-4 h-4 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Call Us Now</span>
          </a>
        </div>

      </div>

      <!-- Right Column: 3D Labourers standing cleanly on main page canvas -->
      <div class="lg:col-span-5 flex items-center justify-center pt-4 lg:pt-0">
        <img 
          src="/hero_3d_labour_clean.png" 
          alt="3D Professional Site Labourers" 
          class="w-full max-w-md h-auto object-contain"
        />
      </div>

    </div>
  </div>
</section>
