---
const sliderImages = [
  { src: "/images/slider/image1.png", alt: "Industrial Workforce Showcase 1" },
  { src: "/images/slider/image2.png", alt: "Industrial Workforce Showcase 2" },
  { src: "/images/slider/image3.png", alt: "Industrial Workforce Showcase 3" },
  { src: "/images/slider/image4.png", alt: "Industrial Workforce Showcase 4" },
  { src: "/images/slider/image5.png", alt: "Industrial Workforce Showcase 5" }
];
---

<section id="home" class="relative pt-6 pb-12 sm:pt-8 sm:pb-16 lg:pt-10 lg:pb-20 overflow-hidden border-b border-zinc-200 bg-white">
  <!-- Subtle Blueprint Grid Accent background -->
  <div class="absolute inset-0 blueprint-grid opacity-30 pointer-events-none"></div>

  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-6 space-y-5">

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-zinc-900 tracking-tight leading-tight">
          Specialized Industrial Workforce.<br />
          <span class="text-amber-600">Pharma, Moulding & Manufacturing.</span>
        </h1>

        <!-- Supporting Paragraph (Truncated to 2 lines on mobile) -->
        <p class="text-base sm:text-lg text-zinc-600 max-w-2xl font-normal leading-relaxed line-clamp-2-mobile">
          We provide vetted, contract-ready manpower teams for <strong>Pharmaceutical Plants</strong>, <strong>Plastic Injection & Blow Moulding units</strong>, <strong>Medical Instrument assembly</strong>, and modern industrial facilities. Flexible shift manpower matched to your plant requirements.
        </p>

        <!-- Key Industry Pills (Hidden on mobile) -->
        <div class="hidden sm:flex flex-wrap gap-2 pt-1">
          <span class="px-3 py-1 bg-zinc-100 border border-zinc-200 text-zinc-800 text-xs font-bold rounded-xs">💊 Pharma Cleanrooms</span>
          <span class="px-3 py-1 bg-zinc-100 border border-zinc-200 text-zinc-800 text-xs font-bold rounded-xs">⚙️ Plastic Blow Moulding</span>
          <span class="px-3 py-1 bg-zinc-100 border border-zinc-200 text-zinc-800 text-xs font-bold rounded-xs">🔬 Medical Instruments</span>
          <span class="px-3 py-1 bg-zinc-100 border border-zinc-200 text-zinc-800 text-xs font-bold rounded-xs">🏭 Plant Operators</span>
        </div>

        <!-- CTA Buttons (Hidden on mobile, bottom sticky bar handles mobile CTAs) -->
        <div class="pt-2 hidden sm:flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a 
            href="/contact" 
            class="inline-flex items-center justify-center px-6 py-3.5 bg-zinc-900 text-white text-xs sm:text-sm font-bold uppercase tracking-wider rounded-xs hover:bg-amber-600 transition-colors shadow-sm group"
          >
            <span>Request Plant Manpower</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href="tel:+919723740019" 
            class="inline-flex items-center justify-center px-6 py-3.5 bg-white text-zinc-900 border-2 border-zinc-900 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-xs hover:bg-zinc-50 transition-colors"
          >
            <svg class="w-4 h-4 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Call Us Now</span>
          </a>
        </div>

      </div>

      <!-- Right Column: 5-Image Interactive Slider -->
      <div class="lg:col-span-6 flex flex-col items-center justify-center relative group">
        
        <!-- Slider Container (Clean Transparent Canvas) -->
        <div class="relative w-full max-w-xl lg:max-w-2xl h-80 sm:h-96 lg:h-[500px] flex items-center justify-center overflow-hidden">
          {sliderImages.map((img, index) => (
            <div 
              class={`hero-slide-item absolute inset-0 w-full h-full transition-all duration-700 ease-in-out ${index === 0 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-95 pointer-events-none z-0'}`} 
              data-slide={index}
            >
              <img 
                src={img.src} 
                alt={img.alt} 
                class="w-full h-full object-contain scale-105"
                loading={index === 0 ? "eager" : "lazy"}
              />
            </div>
          ))}
        </div>

        <!-- Dot Indicators -->
        <div class="flex items-center gap-2 mt-4">
          {sliderImages.map((_, index) => (
            <button 
              class={`hero-dot rounded-full transition-all cursor-pointer ${index === 0 ? 'w-7 h-2.5 bg-amber-500' : 'w-2.5 h-2.5 bg-zinc-300 hover:bg-zinc-400'}`} 
              data-dot={index} 
              aria-label={`Slide ${index + 1}`}
            ></button>
          ))}
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide-item');
  const dots = document.querySelectorAll<HTMLElement>('.hero-dot');

  function showSlide(index: number) {
    if (slides.length === 0) return;
    currentSlide = (index + slides.length) % slides.length;
    
    slides.forEach((item, i) => {
      if (i === currentSlide) {
        item.classList.remove('opacity-0', 'scale-95', 'pointer-events-none', 'z-0');
        item.classList.add('opacity-100', 'scale-100', 'z-10');
      } else {
        item.classList.remove('opacity-100', 'scale-100', 'z-10');
        item.classList.add('opacity-0', 'scale-95', 'pointer-events-none', 'z-0');
      }
    });

    dots.forEach((dot, i) => {
      if (i === currentSlide) {
        dot.classList.remove('bg-zinc-300', 'hover:bg-zinc-400', 'w-2.5');
        dot.classList.add('bg-amber-500', 'w-7');
      } else {
        dot.classList.remove('bg-amber-500', 'w-7');
        dot.classList.add('bg-zinc-300', 'hover:bg-zinc-400', 'w-2.5');
      }
    });
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => showSlide(i));
  });

  // Auto-play slider every 4 seconds
  let interval = setInterval(() => {
    showSlide(currentSlide + 1);
  }, 4000);
</script>
