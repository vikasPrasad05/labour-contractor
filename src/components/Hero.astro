---
---

<section id="home" class="relative pt-12 pb-16 lg:pt-20 lg:pb-24 overflow-hidden border-b border-zinc-200">
  <!-- Subtle Blueprint Grid Accent background -->
  <div class="absolute inset-0 blueprint-grid opacity-40 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight leading-tight">
          Reliable Workforce.<br />
          Ready When You Need It.
        </h1>

        <!-- Supporting Paragraph -->
        <p class="text-base sm:text-lg text-zinc-600 max-w-2xl font-normal leading-relaxed">
          We provide dependable, verified labour and manpower solutions for construction site operations, industrial plants, commercial builds, and infrastructure developments. Flexible teams scaled to your timeline.
        </p>

        <!-- CTA Buttons & Quick Note (Hidden on mobile, visible on sm and up) -->
        <div class="pt-2 hidden sm:flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a 
            href="/contact" 
            class="inline-flex items-center justify-center px-6 py-3.5 bg-zinc-900 text-white text-xs sm:text-sm font-bold uppercase tracking-wider rounded-xs hover:bg-amber-600 transition-colors shadow-xs group"
          >
            <span>Request Manpower</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href="tel:+919723740019" 
            class="inline-flex items-center justify-center px-6 py-3.5 bg-white text-zinc-900 border-2 border-zinc-900 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-xs hover:bg-zinc-50 transition-colors"
          >
            <svg class="w-4 h-4 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Call Us Now</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Printed Image Slider (image2 shown first, then image1 & image3) -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center pt-4 lg:pt-0 relative group">
        
        <!-- Printed Slider Canvas - No Cards -->
        <div class="relative w-full max-w-md h-72 sm:h-80 md:h-96 flex items-center justify-center overflow-hidden">
          <!-- Image 2 (Shows First) -->
          <img 
            src="/image2.png" 
            alt="Workforce Showcase 2" 
            class="hero-slide-img absolute inset-0 w-full h-full object-contain transition-all duration-700 ease-in-out opacity-100 scale-100"
            data-slide="0"
          />
          <!-- Image 1 -->
          <img 
            src="/image1.png" 
            alt="Workforce Showcase 1" 
            class="hero-slide-img absolute inset-0 w-full h-full object-contain transition-all duration-700 ease-in-out opacity-0 scale-95 pointer-events-none"
            data-slide="1"
          />
          <!-- Image 3 -->
          <img 
            src="/image3.png" 
            alt="Workforce Showcase 3" 
            class="hero-slide-img absolute inset-0 w-full h-full object-contain transition-all duration-700 ease-in-out opacity-0 scale-95 pointer-events-none"
            data-slide="2"
          />
        </div>

        <!-- Slider Controls & Indicators -->
        <div class="flex items-center gap-3 mt-4">
          <!-- Prev Arrow -->
          <button 
            id="hero-prev-btn" 
            class="p-1.5 rounded-full bg-zinc-100 text-zinc-700 hover:bg-amber-500 hover:text-white transition-colors cursor-pointer"
            aria-label="Previous Slide"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <!-- Dot Indicators -->
          <div class="flex items-center gap-2">
            <button class="hero-dot w-6 h-2.5 rounded-full bg-amber-500 transition-all cursor-pointer" data-dot="0" aria-label="Slide 1"></button>
            <button class="hero-dot w-2.5 h-2.5 rounded-full bg-zinc-300 transition-all cursor-pointer" data-dot="1" aria-label="Slide 2"></button>
            <button class="hero-dot w-2.5 h-2.5 rounded-full bg-zinc-300 transition-all cursor-pointer" data-dot="2" aria-label="Slide 3"></button>
          </div>

          <!-- Next Arrow -->
          <button 
            id="hero-next-btn" 
            class="p-1.5 rounded-full bg-zinc-100 text-zinc-700 hover:bg-amber-500 hover:text-white transition-colors cursor-pointer"
            aria-label="Next Slide"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll<HTMLImageElement>('.hero-slide-img');
  const dots = document.querySelectorAll('.hero-dot');
  const prevBtn = document.getElementById('hero-prev-btn');
  const nextBtn = document.getElementById('hero-next-btn');

  function showSlide(index: number) {
    if (slides.length === 0) return;
    currentSlide = (index + slides.length) % slides.length;
    
    slides.forEach((img, i) => {
      if (i === currentSlide) {
        img.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
        img.classList.add('opacity-100', 'scale-100');
      } else {
        img.classList.remove('opacity-100', 'scale-100');
        img.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
      }
    });

    dots.forEach((dot, i) => {
      if (i === currentSlide) {
        dot.classList.remove('bg-zinc-300', 'w-2.5');
        dot.classList.add('bg-amber-500', 'w-6');
      } else {
        dot.classList.remove('bg-amber-500', 'w-6');
        dot.classList.add('bg-zinc-300', 'w-2.5');
      }
    });
  }

  prevBtn?.addEventListener('click', () => {
    showSlide(currentSlide - 1);
  });

  nextBtn?.addEventListener('click', () => {
    showSlide(currentSlide + 1);
  });

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => showSlide(i));
  });

  // Auto-play slider every 4 seconds
  setInterval(() => {
    showSlide(currentSlide + 1);
  }, 4000);
</script>
