---
const industries = [
  {
    name: "Pharmaceutical & Biotech Manufacturing",
    code: "IND-01",
    desc: "Sterile cleanroom operations, liquid bottling, tablet packing, blister packaging, and laboratory helpers.",
    badge: "Pharma Cleanroom",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L5.6 15.12a2 2 0 00-1.8.572l-.7.7a2 2 0 000 2.828l2.828 2.828a2 2 0 002.828 0l.7-.7a2 2 0 00.572-1.8l-.477-2.387a6 6 0 01.517-3.86l.158-.318a6 6 0 00.517-3.86l-.477-2.387a2 2 0 00-.547-1.022L6 4" />`
  },
  {
    name: "Plastic Injection & Blow Moulding Units",
    code: "IND-02",
    desc: "Moulding machine operators, bottle blow moulding, container trimming, hopper feeding, and polymer processing.",
    badge: "Blow & Injection Moulding",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />`
  },
  {
    name: "Medical Instruments & Surgical Devices",
    code: "IND-03",
    desc: "Precision device assembly, surgical tool inspection, micro-component fitting, and sterile pouch sealing.",
    badge: "Medical Assembly",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`
  },
  {
    name: "Polymer Processing & Extrusion",
    code: "IND-04",
    desc: "Extrusion line supervision, resin mixing, granule feeding, sheet extrusion, and reel winding teams.",
    badge: "Polymer Extrusion",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`
  },
  {
    name: "Industrial Factories & Automated Lines",
    code: "IND-05",
    desc: "Conveyor line helpers, machine feeders, shift foremen, equipment maintenance support, and assembly crews.",
    badge: "Plant Production",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h5m-5 0V11m0 0h5M12 11H7" />`
  },
  {
    name: "Warehousing, QC & Dispatch Hubs",
    code: "IND-06",
    desc: "Quality control sorting, finished goods packaging, container loading, inventory counting, and dispatch support.",
    badge: "QC & Dispatch",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />`
  }
];
---

<section id="industries" class="py-16 sm:py-20 lg:py-24 bg-white border-b border-zinc-200">
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-zinc-200 gap-6">
      <div class="space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-700">SECTORS & DEPLOYMENT</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight">
          Where Our Workforce Works
        </h2>
      </div>
      <p class="text-sm text-zinc-600 max-w-md font-normal">
        We deploy specialized crew units experienced in the exact safety standards and operational protocols of each industry sector.
      </p>
    </div>

    <!-- Editorial List Layout (Not generic SaaS grid) -->
    <div class="divide-y divide-zinc-200 border-t border-b border-zinc-200">
      {industries.map((ind) => (
        <div class="py-6 sm:py-8 flex flex-col md:flex-row md:items-center justify-between gap-6 hover:bg-zinc-50/80 px-2 sm:px-4 transition-colors group">
          
          <!-- Left: Code & Title -->
          <div class="flex items-start sm:items-center gap-4 md:w-1/2">
            <div class="w-10 h-10 shrink-0 bg-amber-50 border border-amber-300 text-amber-900 flex items-center justify-center rounded-xs group-hover:bg-amber-500 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={ind.icon} />
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-[10px] font-bold text-zinc-400">{ind.code}</span>
                <span class="px-2 py-0.5 bg-zinc-100 border border-zinc-200 text-zinc-700 text-[10px] font-bold uppercase tracking-wider rounded-xs">
                  {ind.badge}
                </span>
              </div>
              <h3 class="text-lg font-bold text-zinc-900 tracking-tight group-hover:text-amber-700 transition-colors">
                {ind.name}
              </h3>
            </div>
          </div>

          <!-- Middle: Description -->
          <p class="text-sm text-zinc-600 font-normal md:w-1/3">
            {ind.desc}
          </p>

          <!-- Right: Direct Link -->
          <div class="md:w-auto flex items-center justify-end">
            <a 
              href="#contact" 
              class="px-4 py-2 border border-zinc-300 text-xs font-bold text-zinc-800 uppercase tracking-wider rounded-xs hover:bg-zinc-900 hover:text-white hover:border-zinc-900 transition-colors"
            >
              Get Crew
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
