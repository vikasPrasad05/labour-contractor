---
const clients = [
  {
    name: "Filatex",
    logo: "/images/clients/filatex.png",
    alt: "Filatex - Client of Aarav Enterprises",
  },
  {
    name: "Levram",
    logo: "/images/clients/levram.png",
    alt: "Levram - Making Healthcare Better",
  },
  {
    name: "Sarvottam Polymers Pvt Ltd",
    logo: "/images/clients/sarvottam-polymers.png",
    alt: "Sarvottam Polymers Pvt Ltd - Delivering Excellence Through Innovation",
  },
  {
    name: "Vivek Group",
    logo: "/images/clients/vivek-group.png",
    alt: "Vivek Group - Client of Aarav Enterprises",
  },
  {
    name: "Alok Industries Limited",
    logo: "/images/clients/alok-industries.png",
    alt: "Alok Industries Limited - Innovative Textile Solutions",
  },
  {
    name: "FAZE3",
    logo: "/images/clients/faze3.png",
    alt: "FAZE3 - Client of Aarav Enterprises",
  },
  {
    name: "Vee Technologies",
    logo: "/images/clients/vee-technologies.png",
    alt: "Vee Technologies - Extraordinary Outcomes",
  },
];

// Duplicate for seamless infinite scroll
const duplicatedClients = [...clients, ...clients];
---

<section id="our-clients" class="py-14 sm:py-16 bg-zinc-50 border-b border-zinc-200">
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center mb-10">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-700">Our Clients</span>
      <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight">
        Trusted by Industry Leaders
      </h2>
      <p class="mt-3 text-sm text-zinc-500 max-w-xl mx-auto leading-relaxed">
        We are proud to partner with leading companies across pharmaceutical, polymer, and healthcare manufacturing sectors.
      </p>
    </div>

    <!-- Marquee Wrapper -->
    <div class="clients-marquee-wrapper relative overflow-hidden">
      <div class="clients-marquee-track flex gap-10 sm:gap-16 items-center">
        {duplicatedClients.map((client) => (
          <div
            class="clients-logo-card flex-shrink-0 flex items-center justify-center bg-white border border-zinc-200 rounded-sm px-5 py-5 w-44 sm:w-52 h-28 sm:h-32 shadow-sm hover:shadow-md hover:border-amber-300 transition-all duration-300"
            aria-label={client.alt}
          >
            <img
              src={client.logo}
              alt={client.alt}
              class="max-h-20 sm:max-h-24 w-auto max-w-full object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Divider accent -->
    <div class="industrial-line mt-10 max-w-xs mx-auto opacity-30"></div>

  </div>
</section>

<style>
  .clients-marquee-wrapper {
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .clients-marquee-track {
    animation: marquee-scroll 28s linear infinite;
    width: max-content;
  }

  .clients-marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clients-marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
