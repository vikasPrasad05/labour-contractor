---
const services = [
  {
    id: "01",
    title: "Pharma Cleanroom Workforce",
    subtitle: "Sterile Packaging & Bottling Line Crew",
    desc: "Trained operators for pharmaceutical manufacturing plants, cleanroom packaging, sterile filling lines, and blister packing operations.",
    tag: "Pharma Vetted",
    image: "/images/services/pharma_labour.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L5.6 15.12a2 2 0 00-1.8.572l-.7.7a2 2 0 000 2.828l2.828 2.828a2 2 0 002.828 0l.7-.7a2 2 0 00.572-1.8l-.477-2.387a6 6 0 01.517-3.86l.158-.318a6 6 0 00.517-3.86l-.477-2.387a2 2 0 00-.547-1.022L6 4" />`
  },
  {
    id: "02",
    title: "Plastic Injection Moulding",
    subtitle: "Mould Setting & Machine Operators",
    desc: "Skilled machine operators and helpers experienced in plastic injection molding machines, component trimming, and polymer processing.",
    tag: "Moulding Experts",
    image: "/images/services/moulding_technicians.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />`
  },
  {
    id: "03",
    title: "Medical Instruments Assembly",
    subtitle: "Precision Tool & Surgical Device Assembly",
    desc: "Meticulous assembly personnel for precision medical devices, surgical equipment, laboratory instrument assembly, and inspection.",
    tag: "Precision Certified",
    image: "/images/services/medical_assembly.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`
  },
  {
    id: "04",
    title: "Plastic Blow Moulding",
    subtitle: "Extrusion Blow Moulding Operators",
    desc: "Dedicated shift teams for plastic blow moulding units, bottle extrusion lines, container trimming, and raw material feeding.",
    tag: "Shift Ready",
    image: "/images/services/plastic_blow_moulding.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`
  },
  {
    id: "05",
    title: "Industrial Plant Operations",
    subtitle: "Factory Line & Shift Manpower",
    desc: "Comprehensive plant workforce deployment including machine operators, material handlers, shift foremen, and utility helpers.",
    tag: "Factory Squads",
    image: "/images/services/industrial_plant_ops.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />`
  },
  {
    id: "06",
    title: "Quality Control & Packaging",
    subtitle: "Batch Inspection & Final Packaging",
    desc: "Rigorous quality check inspectors, dimension verifiers, lab helpers, and export packaging teams for industrial production.",
    tag: "Quality Assured",
    image: "/images/services/quality_inspection.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />`
  }
];
---

<section id="services" class="py-16 sm:py-20 lg:py-24 bg-zinc-50 border-b border-zinc-200">
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Clean Section Header -->
    <div class="max-w-2xl mb-12 sm:mb-16 space-y-3">
      <span class="text-xs font-mono font-bold uppercase tracking-widest text-amber-700">
        OUR CAPABILITIES
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight">
        Our Labour Services
      </h2>
      <p class="text-base text-zinc-600 font-normal leading-relaxed">
        Dependable, pre-screened manpower matched precisely to your project scope and schedule.
      </p>
    </div>

    <!-- 3-Column Grid with increased gaps -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10 lg:gap-x-14 gap-y-14 sm:gap-y-16">
      {services.map((service) => (
        <div class="overflow-hidden flex flex-col justify-between">
          
          <div>
            <!-- Image Container -->
            <div class="relative w-full h-48 sm:h-52 overflow-hidden bg-zinc-100">
              <img 
                src={service.image} 
                alt={service.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-zinc-900/60 via-transparent to-transparent"></div>
            </div>

            <!-- Content Area -->
            <div class="pt-6 pb-4">
              <!-- Title & Subtitle -->
              <h3 class="text-2xl font-extrabold text-zinc-900 tracking-tight mb-1.5">
                {service.title}
              </h3>
              <p class="text-sm font-semibold text-amber-700 mb-4">{service.subtitle}</p>

              <!-- Description -->
              <p class="text-sm sm:text-base text-zinc-600 leading-relaxed font-normal">
                {service.desc}
              </p>
            </div>
          </div>

          <!-- Bottom Action Link -->
          <div class="pt-3 flex items-center mt-auto">
            <a 
              href="/contact" 
              class="text-sm font-bold text-zinc-900 hover:text-amber-700 uppercase tracking-wider flex items-center gap-2 transition-colors"
            >
              <span>Request {service.title}</span>
              <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

