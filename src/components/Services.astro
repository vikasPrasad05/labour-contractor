---
const services = [
  {
    id: "01",
    title: "Skilled Labour",
    subtitle: "Carpenters, Masons, Welders & Electricians",
    desc: "Experienced, trade-certified specialists for complex construction, structural fabrication, and technical site specifications.",
    tag: "Trade Certified",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 4a2 2 0 114 0v1a2 2 0 01-2 2H3a2 2 0 01-2-2V4a2 2 0 012-2h8zM3 10h18M3 14h18M3 18h18" />`
  },
  {
    id: "02",
    title: "Unskilled Labour",
    subtitle: "General Helpers & Site Support",
    desc: "Punctual, physically fit general helpers for site preparation, excavation support, material movement, and general assistance.",
    tag: "General Support",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`
  },
  {
    id: "03",
    title: "Construction Workforce",
    subtitle: "Full Site Crew Deployment",
    desc: "Coordinated worker teams managed by experienced site supervisors for commercial, residential, road, and civil developments.",
    tag: "Managed Teams",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h5m-5 0V11m0 0h5M12 11H7" />`
  },
  {
    id: "04",
    title: "Industrial Manpower",
    subtitle: "Factory & Plant Support",
    desc: "Shift-ready workforce for manufacturing plants, assembly lines, warehouse operations, and industrial equipment support.",
    tag: "Shift Ready",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />`
  },
  {
    id: "05",
    title: "Loading & Unloading",
    subtitle: "Material Handling & Logistics",
    desc: "Robust manpower dedicated to heavy truck loading, warehouse stocking, container handling, and raw material transfers.",
    tag: "Heavy Lifting",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />`
  },
  {
    id: "06",
    title: "Project-Based Supply",
    subtitle: "Flexible Short & Long-Term Scaling",
    desc: "Tailored workforce supply agreements for peak demands, emergency deadlines, or multi-stage project milestones.",
    tag: "Flexible Duration",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />`
  }
];
---

<section id="services" class="py-16 sm:py-20 lg:py-24 bg-zinc-50 border-b border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Clean Section Header -->
    <div class="max-w-2xl mb-12 sm:mb-16 space-y-3">
      <span class="text-xs font-mono font-bold uppercase tracking-widest text-amber-700">
        OUR CAPABILITIES
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight">
        Our Labour Services
      </h2>
      <p class="text-base text-zinc-600 font-normal leading-relaxed">
        Dependable, pre-screened manpower matched precisely to your project scope and schedule.
      </p>
    </div>

    <!-- Premium 3-Column Clean Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {services.map((service) => (
        <div class="bg-white border border-zinc-200 rounded-xl p-6 sm:p-8 hover:border-amber-500 hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          
          <div>
            <!-- Top Icon & Tag -->
            <div class="flex items-center justify-between mb-5">
              <div class="w-12 h-12 rounded-lg bg-amber-50 border border-amber-200 text-amber-900 flex items-center justify-center group-hover:bg-amber-500 group-hover:text-white transition-colors shadow-2xs">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={service.icon} />
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-600 bg-zinc-100 border border-zinc-200 px-3 py-1 rounded-full">
                {service.tag}
              </span>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="text-xl font-extrabold text-zinc-900 tracking-tight mb-1 group-hover:text-amber-700 transition-colors">
              {service.title}
            </h3>
            <p class="text-xs font-semibold text-amber-700 mb-3">{service.subtitle}</p>

            <!-- Concise Description -->
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-normal">
              {service.desc}
            </p>
          </div>

          <!-- Bottom Action Button Link -->
          <div class="pt-5 mt-6 border-t border-zinc-100 flex items-center justify-between">
            <a 
              href="/contact" 
              class="text-xs font-bold text-zinc-900 hover:text-amber-700 uppercase tracking-wider flex items-center gap-1.5 group-hover:gap-2.5 transition-all"
            >
              <span>Request {service.title}</span>
              <svg class="w-4 h-4 text-amber-600 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
