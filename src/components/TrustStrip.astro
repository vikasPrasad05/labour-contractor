---
const trustItems = [
  {
    title: "Skilled & Unskilled Labour",
    desc: "Vetted tradespeople & general workers ready for immediate site deployment.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`
  },
  {
    title: "Flexible Workforce",
    desc: "Daily, weekly, or contract scaling tailored to your operational schedule.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`
  },
  {
    title: "Safety Focused",
    desc: "OSHA & site compliance equipped with verified personal protective gear.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`
  },
  {
    title: "Project-Ready Teams",
    desc: "Quick site dispatch & experienced on-site workforce supervision.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />`
  }
];
---

<section class="py-12 sm:py-16 bg-white border-b border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Printed Directly on Page - No Cards Layout -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0 divide-y sm:divide-y-0 sm:divide-x divide-zinc-200">
      {trustItems.map((item) => (
        <div class="flex flex-col items-center text-center px-4 sm:px-6 py-4 sm:py-2 group">
          
          <!-- Big Top Icon (Printed Editorial Style) -->
          <div class="w-16 h-16 rounded-2xl bg-amber-500/10 text-amber-700 flex items-center justify-center mb-5 group-hover:bg-amber-500 group-hover:text-zinc-950 transition-all duration-300 transform group-hover:-translate-y-1">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon} />
          </div>

          <!-- Title -->
          <h3 class="text-base font-extrabold text-zinc-900 tracking-tight mb-1.5 group-hover:text-amber-700 transition-colors">
            {item.title}
          </h3>

          <!-- Details / Description -->
          <p class="text-xs sm:text-sm text-zinc-600 font-normal leading-relaxed max-w-xs">
            {item.desc}
          </p>

        </div>
      ))}
    </div>

  </div>
</section>

