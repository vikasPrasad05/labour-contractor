---
const advantages = [
  {
    title: "Vetted & Dependable Workers",
    desc: "Every crew member undergoes identity verification, past employment checks, and trade skill assessments before placement."
  },
  {
    title: "Rapid Site Mobilization",
    desc: "Emergency workforce replenishment within 24 to 48 hours for urgent project deadlines or unexpected staff shortages."
  },
  {
    title: "Strict Safety & OSHA Compliance",
    desc: "Workers are equipped with required PPE (hard hats, steel-toe boots, hi-vis vests) and briefed on site hazard safety."
  },
  {
    title: "Dedicated On-Site Supervision",
    desc: "For multi-worker deployments, we assign an experienced foreman/supervisor for daily attendance, safety checks, and coordination."
  },
  {
    title: "Zero Administrative Overhead",
    desc: "We manage payroll, tax withholdings, worker compensation insurance, and employment paperwork entirely."
  },
  {
    title: "Flexible Contracting Terms",
    desc: "No long-term lock-ins. Hire by the day, week, month, or total project duration with clear, transparent hourly or daily rates."
  },
  {
    title: "Deep Local Workforce Network",
    desc: "Established relationships with local trade unions, vocational institutes, and experienced regional labour pools."
  },
  {
    title: "Transparent & Direct Communication",
    desc: "Single point of contact for project managers. Direct dispatch line open 6 days a week from 6:00 AM."
  }
];
---

<section id="why-us" class="py-16 sm:py-20 lg:py-24 bg-zinc-50 border-b border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Copy & Checklist -->
      <div class="lg:col-span-7 space-y-8">
        
        <div class="space-y-3">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-700">PRACTICAL ADVANTAGES</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight leading-tight">
            A Workforce Partner You Can Count On.
          </h2>
          <p class="text-base text-zinc-600 font-normal leading-relaxed">
            We don't make exaggerated claims or fake promises. We focus on what matters to site superintendents and facility managers: reliable people who turn up on time, work safely, and get the job done right.
          </p>
        </div>

        <!-- 8 Practical Advantages Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
          {advantages.map((adv) => (
            <div class="space-y-1.5 p-3.5 bg-white border border-zinc-200 rounded-xs hover:border-amber-500 transition-colors">
              <div class="flex items-center gap-2">
                <!-- Checkmark Icon -->
                <div class="w-5 h-5 shrink-0 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <h3 class="text-sm font-bold text-zinc-900">{adv.title}</h3>
              </div>
              <p class="text-xs text-zinc-600 font-normal leading-relaxed pl-7">
                {adv.desc}
              </p>
            </div>
          ))}
        </div>

      </div>

      <!-- Right Column: Visual Editorial Card -->
      <div class="lg:col-span-5">
        <div class="bg-white border-2 border-zinc-900 p-6 sm:p-8 rounded-xs shadow-[6px_6px_0px_0px_rgba(24,24,27,1)] relative">
          
          <div class="sticker-badge mb-6">
            CONTRACTOR GUARANTEE
          </div>

          <h3 class="text-xl font-bold text-zinc-900 mb-4">Our Operational Promise</h3>

          <div class="space-y-4 text-sm text-zinc-700 font-normal leading-relaxed">
            <div class="p-3.5 bg-zinc-50 border-l-4 border-amber-600">
              <p class="font-bold text-zinc-900 text-xs uppercase tracking-wider">Replacements Within 4 Hours</p>
              <p class="text-xs text-zinc-600 mt-1">If any assigned worker is not suitable for your site requirements, notify us within 4 hours for an immediate replacement at no extra charge.</p>
            </div>

            <div class="p-3.5 bg-zinc-50 border-l-4 border-zinc-900">
              <p class="font-bold text-zinc-900 text-xs uppercase tracking-wider">Full Worker Insurance Covered</p>
              <p class="text-xs text-zinc-600 mt-1">All our labour teams are covered under comprehensive worker compensation and liability insurance.</p>
            </div>

            <div class="p-3.5 bg-zinc-50 border-l-4 border-emerald-600">
              <p class="font-bold text-zinc-900 text-xs uppercase tracking-wider">Compliant Wage & Welfare Standards</p>
              <p class="text-xs text-zinc-600 mt-1">We maintain ethical wage compliance, timely payouts, and fair working standards for all personnel.</p>
            </div>
          </div>


        </div>
      </div>

    </div>

  </div>
</section>
