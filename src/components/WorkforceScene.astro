---
---

<section class="py-16 sm:py-20 bg-zinc-50 border-b border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-white border-2 border-zinc-900 rounded-xs p-6 sm:p-10 relative overflow-hidden shadow-[8px_8px_0px_0px_rgba(24,24,27,1)]">
      
      <!-- Handwritten Style Sticker Quote Floating Badge -->
      <div class="absolute top-4 right-4 sm:top-6 sm:right-6 z-20">
        <div class="bg-amber-100 border-2 border-amber-500 text-amber-950 font-serif italic text-sm sm:text-base font-bold px-4 py-2 rounded-xs transform rotate-2 shadow-xs">
          "The right people make the work move."
        </div>
      </div>

      <!-- Section Label -->
      <div class="space-y-1 mb-6">
        <span class="text-xs font-mono font-bold text-zinc-400 uppercase tracking-widest">FIELD OPERATIONAL TEAM</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight">
          Ready for Heavy Construction & Industrial Operations
        </h2>
      </div>

      <!-- Large Editorial Vector Scene Graphic -->
      <div class="w-full h-72 sm:h-80 relative flex items-center justify-center bg-zinc-50 border border-zinc-200 rounded-xs p-4">
        <svg class="w-full h-full max-h-80" viewBox="0 0 800 320" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Background Scaffold Grid & Sky Lines -->
          <line x1="50" y1="280" x2="750" y2="280" stroke="#18181B" stroke-width="2" />
          <path d="M100 280 V60 H220 V280" stroke="#E4E4E7" stroke-width="1.5" stroke-dasharray="4 4" />
          <path d="M580 280 V90 H700 V280" stroke="#E4E4E7" stroke-width="1.5" stroke-dasharray="4 4" />
          <!-- Diagonal Truss Line -->
          <line x1="100" y1="60" x2="220" y2="120" stroke="#E4E4E7" stroke-width="1.5" />
          <line x1="100" y1="120" x2="220" y2="180" stroke="#E4E4E7" stroke-width="1.5" />

          <!-- Center Group of 4 Workers standing together with tools & safety gear -->
          
          <!-- Worker A: Welder / Metal Worker (Far Left) -->
          <g id="worker-welder">
            <path d="M230 280 V200 C230 185 240 175 255 175 C270 175 280 185 280 200 V280" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
            <rect x="240" y="190" width="30" height="50" fill="#E4E4E7" stroke="#18181B" stroke-width="1.5" />
            <circle cx="255" cy="155" r="14" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
            <!-- Welding Shield / Face Mask -->
            <rect x="244" y="145" width="22" height="22" rx="2" fill="#18181B" />
            <rect x="248" y="150" width="14" height="4" fill="#60A5FA" />
          </g>

          <!-- Worker B: Chief Supervisor with Blueprint (Center Left) -->
          <g id="worker-chief">
            <path d="M320 280 V190 C320 170 335 160 355 160 C375 160 390 170 390 190 V280" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
            <rect x="330" y="175" width="50" height="65" fill="#FDE047" stroke="#18181B" stroke-width="1.5" />
            <line x1="330" y1="195" x2="380" y2="195" stroke="#FFFFFF" stroke-width="4" />
            <circle cx="355" cy="138" r="16" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
            <!-- White Hardhat -->
            <path d="M333 134 C333 118 343 110 355 110 C367 110 377 118 377 134 Z" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
            <path d="M328 134 H382" stroke="#18181B" stroke-width="2.5" stroke-linecap="round" />
            <!-- Roll of Blueprints -->
            <rect x="375" y="190" width="35" height="10" rx="2" fill="#3B82F6" stroke="#18181B" stroke-width="1.5" transform="rotate(-20 375 190)" />
          </g>

          <!-- Worker C: Senior Carpenter / Trades Lead (Center Right) -->
          <g id="worker-carpenter">
            <path d="M430 280 V195 C430 175 445 165 465 165 C485 165 500 175 500 195 V280" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
            <rect x="442" y="180" width="46" height="60" fill="#EA580C" stroke="#18181B" stroke-width="1.5" />
            <line x1="442" y1="200" x2="488" y2="200" stroke="#FFFFFF" stroke-width="4" />
            <circle cx="465" cy="142" r="15" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
            <!-- Orange Hardhat -->
            <path d="M445 138 C445 124 453 116 465 116 C477 116 485 124 485 138 Z" fill="#D97706" stroke="#18181B" stroke-width="2" />
            <path d="M440 138 H490" stroke="#18181B" stroke-width="2.5" stroke-linecap="round" />
            <!-- Spirit Level Tool -->
            <rect x="420" y="210" width="40" height="8" rx="1" fill="#FACC15" stroke="#18181B" stroke-width="1.5" />
          </g>

          <!-- Worker D: General Labourer (Far Right) -->
          <g id="worker-labourer">
            <path d="M530 280 V205 C530 190 540 180 555 180 C570 180 580 190 580 205 V280" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
            <rect x="540" y="195" width="30" height="50" fill="#FDE047" stroke="#18181B" stroke-width="1.5" />
            <circle cx="555" cy="160" r="14" fill="#FFFFFF" stroke="#18181B" stroke-width="2" />
            <!-- Yellow Hardhat -->
            <path d="M538 157 C538 143 545 135 555 135 C565 135 572 143 572 157 Z" fill="#FACC15" stroke="#18181B" stroke-width="2" />
            <path d="M534 157 H576" stroke="#18181B" stroke-width="2.5" stroke-linecap="round" />
          </g>

          <!-- Annotation Tags -->
          <line x1="355" y1="100" x2="355" y2="70" stroke="#D97706" stroke-width="1.5" stroke-dasharray="2 2" />
          <rect x="305" y="48" width="100" height="20" rx="2" fill="#FFFFFF" stroke="#D97706" stroke-width="1.5" />
          <text x="355" y="62" font-family="sans-serif" font-size="9" font-weight="bold" fill="#D97706" text-anchor="middle">VERIFIED TRADESPEOPLE</text>
        </svg>
      </div>

      <!-- Bottom Note -->
      <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-600">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>100% BACKGROUND & TRADES SKILL VERIFIED</span>
        </div>
        <div>
          <span>DISPATCH RADIUS: 100+ MILES</span>
        </div>
      </div>

    </div>

  </div>
</section>
