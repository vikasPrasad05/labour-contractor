---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "Aarav Enterprises | Labour Contractor & Manpower Supply",
  description = "Aarav Enterprises provides reliable labour contractor and manpower supply services for construction, industrial, commercial, and infrastructure projects. Fast deployment, verified compliance, and flexible workforce teams.",
  canonicalUrl = "https://vanguardlabour.com/"
} = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "name": "Aarav Enterprises - Labour & Manpower Services",
  "image": "https://vanguardlabour.com/og-image.jpg",
  "@id": "https://vanguardlabour.com",
  "url": "https://vanguardlabour.com",
  "telephone": "+91 9723740019",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Shop No. 02, Pali Corner, Opp. Gram Panchayat",
    "addressLocality": "Dadra",
    "addressRegion": "Dadra & Nagar Haveli & Daman & Diu",
    "postalCode": "396193",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 20.2667,
    "longitude": 73.0167
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday"
    ],
    "opens": "08:00",
    "closes": "20:00"
  }
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Aarav Enterprises" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    
    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="bg-white text-zinc-900 font-sans antialiased selection:bg-amber-100 selection:text-amber-900 pb-16 md:pb-0">
    <slot />
  </body>
</html>
