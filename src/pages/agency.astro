---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import AgencyOverview from '../components/AgencyOverview.astro';
import ComplianceCertificates from '../components/ComplianceCertificates.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
---

<Layout 
  title="Agency Credentials & Manpower Recruitment | Aarav Enterprises"
  description="Explore Aarav Enterprises manpower agency services, legal compliance, EPF/ESIC statutory registration, and specialized labor supply for Pharma, Moulding, and Factory operations."
>
  <Header />

  <main id="main-content">
    <!-- Page Header Banner -->
    <section class="bg-zinc-900 text-white py-16 lg:py-20 border-b-4 border-amber-600 relative overflow-hidden">
      <div class="absolute inset-0 blueprint-grid opacity-10 pointer-events-none"></div>
      <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl space-y-4">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Premier Industrial Manpower Agency & Labour Contractor
          </h1>
          <p class="text-base sm:text-lg text-zinc-300 font-normal leading-relaxed">
            Aarav Enterprises is your strategic recruitment partner for contract labour, factory staffing, cleanroom packing, and machine maintenance teams across Dadra & Nagar Haveli, Vapi, and surrounding industrial belts.
          </p>
        </div>
      </div>
    </section>

    <!-- Comprehensive Agency Overview Component -->
    <AgencyOverview />

    <!-- Official Government Registrations & Certificates -->
    <ComplianceCertificates />

    <!-- Why Choose Us Component -->
    <WhyChooseUs />

    <!-- Call to Action -->
    <CTASection />
  </main>

  <Footer />
  <MobileStickyBar />
</Layout>
