---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import WorkforceScene from '../components/WorkforceScene.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
---

<Layout 
  title="Vanguard Labour Contractor & Manpower Supply | Skilled & General Workforce"
  description="Dependable labour contractor and manpower supply services for construction, industrial, commercial, and infrastructure projects. On-site supervision, verified compliance, and flexible deployment."
>
  <Header />

  <main id="main-content">
    <Hero />
    <TrustStrip />
    <Services />
    <About />
    <WhyChooseUs />
    <WorkforceScene />
    <CTASection />
  </main>

  <Footer />
  <MobileStickyBar />
</Layout>
