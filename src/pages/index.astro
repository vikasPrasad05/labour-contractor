---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import WorkforceScene from '../components/WorkforceScene.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
---

<Layout 
  title="Aarav Enterprises | Industrial Manpower Contractor - Pharma, Moulding & Medical"
  description="Aarav Enterprises provides specialized industrial contract manpower for Pharmaceutical cleanrooms, Plastic Injection & Blow Moulding plants, Medical Instrument assembly, and manufacturing facilities."
>
  <Header />

  <main id="main-content">
    <Hero />
    <TrustStrip />
    <Services />
    <About />
    <WhyChooseUs />
    <WorkforceScene />
    <CTASection />
  </main>

  <Footer />
  <MobileStickyBar />
</Layout>
