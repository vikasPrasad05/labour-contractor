---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Services from '../components/Services.astro';
import Industries from '../components/Industries.astro';
import Process from '../components/Process.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
---

<Layout 
  title="Our Services | Aarav Enterprises - Industrial Manpower Contractor"
  description="Industrial manpower solutions: Pharma cleanroom packaging, Plastic Injection & Blow Moulding operators, Medical Instrument assembly, quality control inspectors, and plant shift crews."
>
  <Header />

  <main id="main-content">
    <!-- Page Header Banner -->
    <section class="bg-zinc-900 text-white py-16 lg:py-20 border-b-4 border-amber-600 relative overflow-hidden">
      <div class="absolute inset-0 blueprint-grid opacity-10 pointer-events-none"></div>
      <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl space-y-4">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Specialized Plant Manpower<br />
            Pharma, Moulding & Industrial.
          </h1>
          <p class="text-base sm:text-lg text-zinc-300 font-normal leading-relaxed">
            From Pharmaceutical cleanrooms to Plastic Blow Moulding units and Medical Device assembly lines, explore our industrial manpower solutions.
          </p>
        </div>
      </div>
    </section>

    <!-- Services Component -->
    <Services />

    <!-- Industries Component -->
    <Industries />

    <!-- Deployment Process Component -->
    <Process />

    <!-- CTA Section -->
    <CTASection />
  </main>

  <Footer />
  <MobileStickyBar />
</Layout>
